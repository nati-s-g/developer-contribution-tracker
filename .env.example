# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# GitHub OAuth Credentials
# Create an OAuth app at https://github.com/settings/developers
# - Application name: Internship Contribution Tracker
# - Homepage URL: http://localhost:3000
# - Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Session Secret (at least 32 characters for AES-256-GCM cookie encryption)
# Generate e.g. with: openssl rand -base64 32
SESSION_SECRET=

# Supabase configuration (deferred until persistence needed in later phases)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
